# Shopify App Credentials
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
SHOPIFY_SCOPES=read_products
SHOPIFY_APP_URL=https://your-ngrok-url.ngrok.io
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/size_helper

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=DEBUG

# Session
SESSION_SECRET=your_session_secret_here

# RMS Partner Programme (reedmace's internal API)
# PARTNER_API_KEY must match the same var in the reedmace repo and the
# other 3 RMS apps exactly.
PARTNER_API_URL=https://reedmace.net
PARTNER_API_KEY=your_partner_api_key_here
